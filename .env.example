# .env.example - Plantilla de variables de entorno para robomatic-test-executor-api
CONFIGURATION_SETUP="config.LocalConfig"
EVIDENCE_FILE_DIR="/home/evidence"
HOST="0.0.0.0"
PORT="5007"
RESOURCES_DIR="/app/resources"
BUILD_CONTEXT_DIR="/app/resources/context"
SELENIUM_IMAGE="selenium/standalone-chrome:latest"
TEST_CASES_DIR="/home/cases/"

# --- BASE DE DATOS (PostgreSQL Neon Cloud) ---
# Opción 1: Conexión completa
DB_SERVER_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/test_executor?sslmode=require"
# Opción 2: Partes individuales (fallback automático)
DB_HOST=""
DB_USER=""
DB_PWD=""
DB_PORT="5432"
DB_NAME="test_executor"

# --- RABBITMQ (CloudAMQP SSL) ---
RABBIT_SERVER_URL="amqps://<USER>:<PASSWORD>@<HOST>.rmq.cloudamqp.com/<VHOST>"
CLOUDAMQP_URL="amqps://<USER>:<PASSWORD>@<HOST>.rmq.cloudamqp.com/<VHOST>"

# --- BROWSERLESS CLOUD RUN ---
BROWSERLESS_HOST="robomatic-browserless-80770840815.southamerica-west1.run.app"
BROWSERLESS_TOKEN=""

# --- CLOUDFLARE R2 OBJECT STORAGE ---
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="robomatic-evidence"

# --- SEGURIDAD ---
ENCRYPTION_SECRET_KEY=""

# --- MICROSERVICIOS AUXILIARES ---
REST_API_URL="http://robomatic-rest-api:5002/rest-api/v1/consume"
DATABASE_API_URL="http://robomatic-database-api:5003/database-api/v1/consume"
MAIL_API_URL="http://robomatic-email-ms:5006/email-api/v1/send-mail"
JMS_API_URL="http://robomatic-jms-api:5005/jms-api/v1/consume"
GDRIVE_API_URL="http://robomatic-gdrive-api:5008/gdrive-api/vi/consume"
AI_API_URL="http://robomatic-ai-api:5009/ai/v1/execute"
FILE_MANAGER_API_URL="http://robomatic-file-manager-api:5000"
